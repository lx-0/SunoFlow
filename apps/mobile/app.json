{
  "expo": {
    "name": "SunoFlow",
    "slug": "sunoflow",
    "scheme": "sunoflow",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sunoflow.mobile",
      "appleTeamId": "5PWMW95U2P",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "SunoFlow does not record audio; this is required because the waveform library bundles recording code.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-video",
      "expo-screen-orientation"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
