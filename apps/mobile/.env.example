# Copy to .env and fill in. .env and .env*.local are gitignored repo-wide.
# Expo reads this file for EXPO_PUBLIC_* at bundle time; scripts/testflight.sh
# reads the ASC_* values from it.

# Backend the app talks to. Defaults to production when unset; point it at a LAN
# address to develop against a local server (the phone cannot reach localhost).
# EXPO_PUBLIC_SUNOFLOW_BASE_URL=http://192.168.2.58:3000

# --- App Store Connect API key — OPTIONAL, off by default ---------------------
# `pnpm testflight` authenticates with the Apple ID signed into Xcode, which works
# because that account is the team's Account Holder. A key is only needed for
# unattended runs, and it must have the ADMIN role: an App Manager key is refused
# with FORBIDDEN_ERROR "You haven't been given access to cloud-managed distribution
# certificates". Set ASC_USE_KEY=1 to switch the script over to the key.
# ASC_USE_KEY=1

# App Store Connect → Users and Access → Integrations → App Store Connect API →
# Team Keys. The Key ID is in the key's row, the Issuer ID above the table.
ASC_KEY_ID=
ASC_ISSUER_ID=

# Where the downloaded AuthKey_<ASC_KEY_ID>.p8 lives. Leave unset to use
# apps/mobile/certs/AuthKey_<ASC_KEY_ID>.p8, falling back to
# ~/.appstoreconnect/private_keys/ (the directory Xcode itself reads).
# ASC_KEY_PATH=
