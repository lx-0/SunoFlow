<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Export options for `pnpm testflight` (scripts/testflight.sh).
         Lives outside ios/ on purpose: ios/ is gitignored and regenerated by
         `expo prebuild`, this file is not. -->

    <!-- App Store Connect distribution. "app-store" is the deprecated spelling. -->
    <key>method</key>
    <string>app-store-connect</string>

    <!-- Hand the .ipa straight to App Store Connect instead of writing it to disk,
         so no separate altool/Transporter step is needed. -->
    <key>destination</key>
    <string>upload</string>

    <!-- Wach & Wegener UG. Must match ios.appleTeamId in app.json. -->
    <key>teamID</key>
    <string>5PWMW95U2P</string>

    <!-- Let Xcode create/renew the distribution certificate and App Store
         provisioning profile (requires -allowProvisioningUpdates). -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- dSYMs for symbolicated crash reports in App Store Connect. -->
    <key>uploadSymbols</key>
    <true/>

    <!-- Xcode assigns a unique build number at upload time, so app.json's
         ios.buildNumber does not have to be bumped for every TestFlight build.
         The marketing version (CFBundleShortVersionString) still comes from
         app.json's `version`. -->
    <key>manageAppVersionAndBuildNumber</key>
    <true/>
  </dict>
</plist>
